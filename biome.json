{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "files": {
    "includes": [
      "**",
      "!.tes/bin/cortex_embed.mjs",
      "!.tes/postinstall.json",
      "!.tes/postinstall-runs",
      "!.tes/manifest.json",
      "!.tes/tes-install-lock.json"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none"
    }
  },
  "json": {
    "formatter": {
      "expand": "auto",
      "trailingCommas": "none"
    }
  }
}
